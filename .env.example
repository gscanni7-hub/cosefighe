# Copia questo file in .env (in locale) o nelle Environment Variables di Vercel.

# Database e autenticazione (opzionali). Senza, il sito usa i dati statici e
# i moduli aprono la tua app di posta con il messaggio già pronto.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Accesso al pannello admin quando Supabase NON è configurato (almeno 8 caratteri).
# Con Supabase configurato si usa invece l'utente creato in Authentication.
VITE_ADMIN_PASSWORD=
